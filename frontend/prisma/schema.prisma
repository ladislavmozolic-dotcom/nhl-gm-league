generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id      Int      @id @default(autoincrement())
  slug    String   @unique
  name    String
  gm      String
  arena   String

  players Player[]
}

model Player {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  name     String
  position String

  teamId   Int
  team     Team   @relation(fields: [teamId], references: [id])
}