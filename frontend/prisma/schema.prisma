generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id      Int    @id @default(autoincrement())
  slug    String @unique
  code    String? @unique
  name    String
  gm      String
  arena   String

  league String @default("NHL")

  eliteProspectsUrl String?

  parentTeamId Int?
  parentTeam Team? @relation("Affiliates", fields: [parentTeamId], references: [id])

  affiliateTeams Team[] @relation("Affiliates")

  players Player[]
}


model Player {
  id       Int    @id @default(autoincrement())
  slug     String @unique

  name     String
  position String
  positions String?

  nhlId    Int?   @unique
  number   Int?

  photoUrl String?

  frozenPoolId Int?
  frozenPoolUrl String?
  frozenPoolPlayerSlug String?


  birthDate String?
  birthPlace String?
  nationality String?

  shoots String?

  height String?
  weight Int?

  capHit         Float?
  contractYears  Int?
  contractExpiry Int?

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])
}