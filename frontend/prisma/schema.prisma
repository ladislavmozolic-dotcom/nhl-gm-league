generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id      Int    @id @default(autoincrement())
  slug    String @unique
  code    String? @unique
  name    String
  logoUrl String?
  gm      String
  arena   String
  profinhlName String? @unique

  league String @default("NHL")

  eliteProspectsUrl String?

  parentTeamId Int?
  parentTeam Team? @relation("Affiliates", fields: [parentTeamId], references: [id])

  affiliateTeams Team[] @relation("Affiliates")

  players Player[]
}


model Player {
  id       Int    @id @default(autoincrement())
  slug     String @unique

  name     String
  position String
  positions String?

  nhlId    Int?   @unique
  number   Int?

  photoUrl String?

  frozenPoolId Int?
  frozenPoolUrl String?
  frozenPoolPlayerSlug String?


  birthDate String?
  birthPlace String?
  nationality String?

  shoots String?

  height String?
  weight Int?
capWagesSlug String?
  capHit         Float?
  contractYears  Int?
  contractExpiry Int?
  age Int?
overall Int?
contractText String?
rosterType String?
condition Float?

ck Int?
fg Int?
di Int?
sk Int?
st Int?
en Int?
du Int?
ph Int?
fo Int?
pa Int?
sc Int?
df Int?
ps Int?
ex Int?
ld Int?
mo Int?

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])
}