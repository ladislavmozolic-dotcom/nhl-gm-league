# Copy to .env on the server and fill in real values. NEVER commit the real .env.

# Your domain (must point to the server's IP — see DEPLOY.md step 3).
DOMAIN=liga.tvojadomena.sk

# Postgres — pick a strong password.
POSTGRES_USER=profinhl
POSTGRES_PASSWORD=CHANGE-ME-to-a-long-random-string
POSTGRES_DB=profinhl

# The app connects to the `db` service by name. Keep user/pass/db in sync with the
# three lines above.
DATABASE_URL=postgresql://profinhl:CHANGE-ME-to-a-long-random-string@db:5432/profinhl?schema=public
